{
  "permissions": {
    "allow": [
      "Skill(session_save)",
      "Bash(bash *prepare_session_commit.sh*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/_system/hooks/harness/session_start_hook.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/_system/hooks/harness/stop_hook.sh\""
          }
        ]
      }
    ]
  }
}
